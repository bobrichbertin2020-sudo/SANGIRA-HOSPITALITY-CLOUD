NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only. Never expose these with a NEXT_PUBLIC_ prefix.
# Required only for CLI database migrations; URL-encode special password characters.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
# 32+ random characters; signs customer QR ordering sessions.
ORDER_SESSION_SECRET=
# Public https origin of the app (QR links and payment callbacks).
APP_BASE_URL=
# 32+ random characters; signs payment callback URLs.
PAYMENT_CALLBACK_SECRET=

# MTN MoMo Collection (sandbox by default)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
# The MTN sandbox only accepts EUR; leave empty in production.
MTN_MOMO_CURRENCY=EUR

# Airtel Money Open API (UAT by default)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_DIAL_CODE=256

supabase migration list
supabase db push --dry-run
supabase db push
notify pgrst, 'reload schema';
